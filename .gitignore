.env
.venv/
# A second venv for running this on macOS: the one above was built on the
# VPS and its binaries are Linux (Day 26 runs the local model on the laptop).
.venv-mac/
__pycache__/
*.pyc
*.log
.DS_Store
*.backup
# Runtime state lives in data/ and is not versioned - except the corpus the
# indexing pipeline reads, which has to travel with the project (Day 21).
data/*
!data/documents/
!data/rag/
!data/chat/
# Day 33: the synthetic support CRM and its evaluation scenarios are source.
!data/support/
# Day 29: the evaluation questions are versioned; results are not.
!data/evaluation/
# ...but the results of an evaluation run are output, not source.
data/rag/evaluation_results.json
data/rag/day23_results.json
data/rag/day24_results.json
data/rag/day24_comparison.json
data/chat/day25_results.json
# Evaluation output is not source; the question sets are (Days 28-31).
data/evaluation/*
!data/evaluation/*_questions.json
